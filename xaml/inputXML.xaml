                        <Border Height="4" CornerRadius="2" Background="{DynamicResource FluentBtnBgDisabled}" VerticalAlignment="Center" Margin="7,0"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Horizontal">
