    <!-- Round 13: Uninstall Manager list. Do NOT rely on the hardcoded-dark
         ListViewItem* compat keys above - bind to the same theme-refreshed Fluent
         semantic brushes as ComboBox/ComboBoxItem (round 11 lesson). -->
    <!-- Round 13: Uninstall Manager list containers. Explicit keyed styles attached via
         ItemContainerStyle / ColumnHeaderContainerStyle: ModernWpf's ListView default style
         sets its own ItemContainerStyle, which beats an implicit element style and renders
         unreadable white-on-white rows (real-machine evidence, round 13). -->
    <Style x:Key="UninstItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <GridViewRowPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource FluentListHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource FluentCheckedBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MainForegroundColor}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}"/>
                        </Trigger>
